{
    "name": "yexca-blog",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "HUGO_VERSION": "0.166.0"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "budparr.language-hugo-vscode", // Hugo 语法高亮
                "ritwickdey.LiveServer"         // 实时预览辅助
            ]
        }
    },

    // 启动预览：hugo server --bind 0.0.0.0 --poll 700ms
    // Windows 宿主机挂载的目录收不到文件变更事件，需要 --poll 才能热重载
    "forwardPorts": [1313],
    "portsAttributes": {
        "1313": { "label": "Hugo" }
    },

    "remoteUser": "vscode"
}